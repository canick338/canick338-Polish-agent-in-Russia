                            }
                        ],
                        "type": "choice"
                    },
                    {
                        "character": "chief",
                        "side": "right",
                        "expression": "chief_neutral",
                        "text": "На сегодня всё. Иди отсыпайся. Завтра финальный экзамен на выживание.",
                        "type": "dialogue"
