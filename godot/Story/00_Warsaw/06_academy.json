                                        "type": "dialogue"
                                    }
                                ]
                            },
                            {
                                "text": "Избить манекен стулом (Физическое насилие)",
                                "children": [
                                    {
                                        "character": "",
                                        "text": "Данила молча берет железный стул со спинкой и со всей силы обрушивает его на манекен. Голова манекена отлетает в стену.",
                                        "type": "dialogue"
                                    },
                                    {
                                        "character": "danila",
                                        "expression": "panting",
                                        "text": "Он... раскололся, сэр.",
                                        "type": "dialogue"
                                    },
                                    {
                                        "character": "chief",
                                        "side": "right",
                                        "expression": "chief_pointing_smile",
                                        "text": "БУКВАЛЬНО! Мне нравится твой подход! Жёстко, эффективно, травмоопасно!",
                                        "type": "dialogue"
                                    }
                                ]
