[sub_resource type="Shader" id="Shader_spin"]
code = "shader_type canvas_item;
uniform float angle = 0.0;

void fragment() {
	vec2 center = vec2(0.5, 0.5);
	vec2 uv = UV - center;
	float s = sin(angle);
	float c = cos(angle);
	// Basic rotation
	vec2 new_uv = vec2(uv.x * c - uv.y * s, uv.x * s + uv.y * c) + center;
	
	// Check bounds to avoid artifacts if texture doesn't repeat/clamp properly (optional, usually texture repeats or clamps)
	// For now just sample
	COLOR = texture(TEXTURE, new_uv);
    
    // Oval Mask
	if (distance(UV, center) > 0.5) {
		COLOR.a = 0.0;
	}
}"

